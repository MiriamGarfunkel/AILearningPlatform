MONGO_URI=mongodb://localhost:27017/ai_learning
PORT=5000

# Required in production (see src/config/env.ts). Use a long random string.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=30d

# Optional: OpenAI key for live generations. Leave empty to exercise stub / fallback paths.
OPENAI_API_KEY=

# Controls which lesson provider stack runs (see README “AI provider toggle”).
# Values: auto | remote | offline
AI_PROVIDER_MODE=auto

# Optional: set to "production" in deployed environments (enforces JWT_SECRET).
# NODE_ENV=development

# --- Bootstrap admin (npm run seed:admin) ---
# After seeding, sign in via “Admin login” using email + password, or national ID + name + phone.
ADMIN_EMAIL=admin@ailocal.test
ADMIN_PASSWORD=AdminLocal#2026
ADMIN_ID=900000001
ADMIN_NAME=Miriam Garfunkel
ADMIN_PHONE=+15550000001

# English-only catalog: deletes ALL categories and subcategories, then inserts English labels.
# Run from Backend: npm run seed:catalog:english

MONGO_URI=mongodb://localhost:27017/ai_learning
PORT=5000

# Required in production (see src/config/env.ts). Use a long random string.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=30d

# Optional: OpenAI key for live generations. Leave empty to exercise stub / fallback paths.
OPENAI_API_KEY=

# Controls which lesson provider stack runs (see README “AI provider toggle”).
# Values: auto | remote | offline
AI_PROVIDER_MODE=auto

# Optional: set to "production" in deployed environments (enforces JWT_SECRET).
# NODE_ENV=development
